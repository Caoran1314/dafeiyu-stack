# ============ 复制成 .env 再改 ============
# 镜像源：国内可换成 m.daocloud.io/docker.io
MIRROR=docker.io

# 端口（改左边，右边是容器内端口别动）
ASTRBOT_WEBUI_PORT=16185
NAPCAT_WEBUI_PORT=16099
OLLAMA_PORT=11434
ASR_PORT=9001
SOVITS_PORT=9880

# 数据目录：所有持久化数据都落这里
DATA_ROOT=./data

# NapCat 以哪个用户跑 QQ（Linux 上填 `id -u` / `id -g` 的值）
NAPCAT_UID=1000
NAPCAT_GID=1000

TZ=Asia/Shanghai

# 镜像标签（一般 latest，想固定版本就写具体 tag）
ASTRBOT_TAG=latest
NAPCAT_TAG=latest
OLLAMA_TAG=latest

# GPT-SoVITS 镜像（不用语音就注释掉 compose 里 sovits 那段）
SOVITS_IMAGE=docker.io/xxxxx/gpt-sovits:latest
